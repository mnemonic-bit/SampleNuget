<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0</TargetFrameworks>
    <LangVersion>8.0</LangVersion>
    <Version>0.6.0</Version>
    <OutputType>library</OutputType>

    <Title>Nuget sample project</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <RepositoryUrl>https://github.com/mnemonic-bit/SampleNuget.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Authors>mruether</Authors>
    <Copyright>mruether</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <PackageId>mnemonic-bit.SampleNuget</PackageId>
    <Description>Nuget sample project for demonstrating how to push a Nuget from Github.</Description>
    <PackageTags>sample, nuget, package</PackageTags>
	  <IsPackable>true</IsPackable>
    <IsTrimmable>true</IsTrimmable>

	  <AssemblyName>SampleNuget</AssemblyName>
	  <RootNamespace>SampleNuget</RootNamespace>
    <Nullable>enable</Nullable>


    <!-- Required for SourceLink: Embed compiler-generated sources in the PDB, e.g. AssemblyInfo.cs -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Required for SourceLink: Include repository URL in package metadata -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Optional for SourceLink: Include PDB files; this will increase package size, and it it recommended to set up a symbol-server for this instead. -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Introduced for SourceLink: Will mark this as a result of a CI/CD pipeline. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Required for SourceLink -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <!--<PackageReference Include="DotNet.ReproducibleBuilds" Version="1.2.25">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>-->
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
